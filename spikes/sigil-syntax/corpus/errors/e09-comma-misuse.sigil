sigil 1
// 04-mirrored-spiral: one spiral arm, mirrored into three counter-rotating pairs, whose
// bullets breathe with a tempo curve (fast launch, near stop, hold, release).
// Covers: block spiral, modifiers rotate + mirror (n-fold) + speed_curve (4 keyframes,
//         smooth interpolation), flag grazeable, stacked modifiers in written order.

meta {
  name = "Mirrored Spiral"
  difficulty = [hard, curtain]
  density = 540 // 90 shots x 2 mirrored x 3 folds
}

// Petal: the only bullet type of this unit.
bullet petal {
  silhouette = petal
  palette = enemy.rose
  glow = 0.5
  radius = 0.18u
  damage = 1
  flags = [grazeable]
}

emitter bloom {
  bullet = petal
  repeat = 90
  interval = 2t
  speed = 0.09u/t
  block spiral {
    arms = 1
    step = 11deg // angle added per shot
    start = 90deg
  }
  modifier rotate {
    rate = 0.5deg/t // slow drift of the whole figure on top of the spiral step
  }
  modifier mirror {
    axis = 90deg // mirror across the vertical axis: counter-rotating twin arm
    folds = 3 // repeat the mirrored pair three times around the circle (6 arms)
  }
  modifier speed_curve {
    // Tempo curve over bullet age: fast launch, near stop, hold, release.
    keys = [
      (at = 0t, mul = 1.6),
      (at = 20t, mul = 0.3),,
      (at = 60t, mul = 0.3),
      (at = 90t, mul = 1.2),
    ]
    interp = smooth
  }
}
