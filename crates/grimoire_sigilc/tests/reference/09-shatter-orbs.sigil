sigil 1
// 09-shatter-orbs: heavy orbs that shatter into a small ring of fragments after five units of
// travel, so the danger arrives where the player dodged to.
// Covers: transform burst on a distance trigger with its own nested block, sub-bullets one
//         cascade level deeper, despawn_vfx.

meta {
  name = "Shatter Orbs"
  difficulty = [hard, area]
  density = 150
}

// Heavy orb; smashing it early prevents the shatter.
bullet heavy {
  silhouette = orb
  palette = enemy.hex_magenta
  glow = 0.9
  radius = 0.35u
  damage = 2
  flags = [smashable]
  transform burst {
    when = distance 5u
    bullet = fragment
    speed = 0.09u/t
    block ring {
      count = 8
      start = 22.5deg
    }
  }
}

// Fragment of a shattered orb.
bullet fragment {
  silhouette = diamond
  palette = enemy.poison_lime
  glow = 0.4
  radius = 0.12u
  damage = 1
  flags = [grazeable]
  despawn_vfx = fragment_puff // played on bullet clear (FR-12)
}

emitter heavies {
  bullet = heavy
  repeat = forever
  interval = 60t
  speed = 0.05u/t
  block fan {
    count = 3
    spread = 60deg
    center = 270deg
  }
}
